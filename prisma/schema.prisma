// Hub: banco de dados da etapa 1 (WhatsApp e grupos)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Os 2 acessos do painel
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  phone        String?  // número autorizado a dar comandos no grupo de resultados (só dígitos, com DDI)
  createdAt    DateTime @default(now())
}

enum Role {
  ADMIN
  TEAM
}

// Grupos do WhatsApp lidos da Evolution
model Group {
  id          String   @id @default(cuid())
  jid         String   @unique // ex.: 1203630...@g.us
  name        String
  description String?
  size        Int      @default(0)
  capacity    Int      @default(1024)
  isCommunity Boolean  @default(false) // escolhido no painel: entra nas métricas, na mensagem de volta e nos disparos
  isResults   Boolean  @default(false) // grupo de resultados (relatório e comandos)
  inviteCode  String?
  iAmAdmin    Boolean  @default(false) // o número conectado é admin
  kind        String   @default("grupo") // grupo | comunidade | avisos
  parentJid   String?  // comunidade a que o grupo pertence
  archived    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  members     Membership[]
  events      MemberEvent[]
}

// Pessoa (um número de WhatsApp)
model Contact {
  id          String   @id @default(cuid())
  phone       String   @unique // só dígitos, com DDI
  name        String?
  firstSeenAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  events      MemberEvent[]
}

model Membership {
  id        String    @id @default(cuid())
  groupId   String
  contactId String
  isAdmin   Boolean   @default(false)
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([leftAt])
}

enum EventType {
  JOIN
  LEAVE
  RETURN
}

// Histórico de entradas e saídas
model MemberEvent {
  id         String    @id @default(cuid())
  type       EventType
  groupId    String
  contactId  String
  byAdmin    Boolean   @default(false) // removido por admin
  winbackSent Boolean  @default(false) // mensagem de volta enviada
  createdAt  DateTime  @default(now())
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([type, createdAt])
}

enum ScheduleStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

// Mensagens agendadas para os grupos
model ScheduledMessage {
  id          String         @id @default(cuid())
  text        String
  mediaUrl    String?
  mediaType   String?        // image | video | audio | document
  mentionAll  Boolean        @default(true)
  groupJids   String[]
  sendAt      DateTime
  repeat      String?        // null | daily | weekly
  status      ScheduleStatus @default(SCHEDULED)
  sentCount   Int            @default(0)
  error       String?
  createdBy   String?
  launchId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, sendAt])
}

// Configurações simples (chave e valor)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Custos lançados (por comando no grupo ou no painel)
enum CostKind {
  FIXED     // custo fixo mensal (sai inteiro no mês)
  VARIABLE  // custo avulso
  STOCK_LOT // lote de estoque (custo dividido por unidade)
}

model Cost {
  id          String   @id @default(cuid())
  kind        CostKind
  description String
  amount      Decimal  @db.Decimal(12, 2) // valor total
  units       Int?     // lote: quantidade de peças
  unitCost    Decimal? @db.Decimal(12, 2) // lote: custo por peça
  productKey  String?  // lote: palavra que liga o lote ao produto (ex.: "pura")
  month       String?  // AAAA-MM a que o custo pertence
  recurring   Boolean  @default(false)
  source      String   @default("painel") // painel | whatsapp
  createdBy   String?
  createdAt   DateTime @default(now())
}

// Registro dos comandos recebidos no grupo de resultados
model CommandLog {
  id         String   @id @default(cuid())
  fromPhone  String
  input      String   // texto digitado ou transcrição do áudio
  wasAudio   Boolean  @default(false)
  intent     String?
  reply      String?
  pending    Json?    // ação aguardando "ok"
  status     String   @default("done") // done | awaiting_confirmation | confirmed | canceled | error
  createdAt  DateTime @default(now())
}

// ---------- Etapa 2 ----------

// Leads captados no formulário da página do Grupo VIP (ou importados)
model Lead {
  id        String   @id @default(cuid())
  name      String?
  phone     String   @unique // só dígitos, com DDI
  email     String?
  birthday  String?  // DD/MM
  source    String   @default("grupo-vip") // página ou formulário de origem
  utmSource String?
  utmMedium String?
  utmCampaign String?
  utmContent String?
  utmTerm   String?
  status    String   @default("novo") // novo | no_grupo | cliente | descadastrado
  welcomeSent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  PAUSED
  DONE
  CANCELED
}

// Disparos em massa no privado
model Broadcast {
  id         String          @id @default(cuid())
  name       String
  text       String
  mediaUrl   String?
  mediaType  String?
  audience   String          // leads | clientes | vip | inativos | recorrentes | lista
  status     BroadcastStatus @default(DRAFT)
  sendAt     DateTime?
  total      Int             @default(0)
  sent       Int             @default(0)
  failed     Int             @default(0)
  createdBy  String?
  createdAt  DateTime        @default(now())
  recipients BroadcastRecipient[]
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  phone       String
  name        String?
  status      String    @default("pendente") // pendente | enviado | falhou | pulado
  error       String?
  sentAt      DateTime?
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, phone])
  @@index([broadcastId, status])
}

// Quem pediu para não receber mais mensagens
model OptOut {
  phone     String   @id
  createdAt DateTime @default(now())
}

// Tarefas (kanban)
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("a_fazer") // a_fazer | fazendo | feito
  priority    String    @default("normal")  // baixa | normal | alta
  assignee    String?
  dueDate     DateTime?
  order       Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Votações (enquete no grupo ou página fechada)
model Poll {
  id         String     @id @default(cuid())
  question   String
  options    String[]
  mode       String     @default("grupo") // grupo | pagina
  groupJids  String[]
  imageUrls  String[]
  closesAt   DateTime?
  status     String     @default("aberta") // aberta | fechada
  createdBy  String?
  createdAt  DateTime   @default(now())
  votes      PollVote[]
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  phone     String
  name      String?
  option    Int
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, phone])
}

// ---------- Etapa 3 ----------

// Recuperação e avisos automáticos (carrinho, Pix, rastreio, entregue, pós-venda)
model RecoveryCase {
  id             String    @id @default(cuid())
  kind           String    // carrinho | pix | rastreio | entregue | avaliacao
  refId          String    // id do checkout ou do pedido na Shopify
  phone          String
  name           String?
  email          String?
  value          Float     @default(0)
  url            String?
  product        String?
  orderName      String?
  tracking       String?
  status         String    @default("ativo") // ativo | recuperado | concluido | sem_resposta | parado
  step           Int       @default(0)
  nextAt         DateTime?
  sentCount      Int       @default(0)
  lastSentAt     DateTime?
  recoveredAt    DateTime?
  recoveredValue Float?
  createdAt      DateTime  @default(now())

  @@unique([kind, refId])
  @@index([status, nextAt])
  @@index([kind, createdAt])
}

// Atendimento: conversas no privado
model ChatThread {
  phone     String   @id
  name      String?
  lastText  String?
  lastAt    DateTime @default(now())
  unread    Int      @default(0)
  aiEnabled Boolean  @default(true)
  status    String   @default("aberto") // aberto | resolvido
  assignee  String?
  messages  ChatMessage[]
}

model ChatMessage {
  id        String     @id @default(cuid())
  phone     String
  fromMe    Boolean    @default(false)
  by        String     @default("cliente") // cliente | equipe | ia | sistema
  text      String
  messageId String?    @unique
  createdAt DateTime   @default(now())
  thread    ChatThread @relation(fields: [phone], references: [phone], onDelete: Cascade)

  @@index([phone, createdAt])
}

// Indique e ganhe
model Referral {
  id         String   @id @default(cuid())
  phone      String   @unique
  name       String?
  email      String?
  code       String   @unique
  discountId String?
  uses       Int      @default(0)
  revenue    Float    @default(0)
  kind       String   @default("cliente") // atleta | comunidade | cliente
  payout     String   @default("credito") // pix | credito
  clicks     Int      @default(0)
  note       String?
  instagram  String?
  discountPct Float?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Lançamentos (drops)
model Launch {
  id        String   @id @default(cuid())
  name      String
  opensAt   DateTime
  closesAt  DateTime?
  productKey String?
  groupJids String[]
  goal      Int?     // meta de pessoas no grupo
  liveUrl   String?  // link da live ou da coleção
  about     String?
  status    String   @default("planejado") // planejado | aberto | encerrado
  createdBy String?
  createdAt DateTime @default(now())
}

// Funis: sequência de mensagens no privado a partir de um gatilho
model Funnel {
  id        String      @id @default(cuid())
  name      String
  trigger   String      // lead_novo | entrou_grupo | primeira_compra | saiu_grupo
  active    Boolean     @default(true)
  steps     Json        // [{ delayMin, text }]
  createdAt DateTime    @default(now())
  runs      FunnelRun[]
}

model FunnelRun {
  id        String    @id @default(cuid())
  funnelId  String
  phone     String
  name      String?
  step      Int       @default(0)
  nextAt    DateTime?
  status    String    @default("ativo") // ativo | concluido | parado
  createdAt DateTime  @default(now())
  funnel    Funnel    @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, phone])
  @@index([status, nextAt])
}

// Diagnósticos gerados pela IA
model Diagnosis {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
}

// Lista de espera: quem pediu para ser avisado quando o tamanho voltar
model Waitlist {
  id         String    @id @default(cuid())
  phone      String
  name       String?
  product    String
  variant    String    @default("")
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([phone, product, variant])
  @@index([product])
}

// Pagamento de comissão de atleta ou influenciador (todo dia 1, do mês anterior)
model Payout {
  id         String    @id @default(cuid())
  referralId String
  month      String    // AAAA-MM das vendas
  sales      Float     @default(0)
  amount     Float
  paidAt     DateTime  @default(now())
  method     String    @default("pix")
  createdBy  String?

  @@unique([referralId, month])
}
