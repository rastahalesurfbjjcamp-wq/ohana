# Copie para as variáveis de ambiente do Easypanel. Nunca coloque chaves no código nem no chat.

# Painel
APP_URL=https://painel.rastahale.com.br
SESSION_SECRET=           # um texto aleatório longo (ex.: gerado com: openssl rand -hex 32)
TZ_LOJA=America/Sao_Paulo
DATABASE_URL=postgresql://ohana:SENHA@ohana-postgres:5432/ohana
REDIS_URL=redis://default:SENHA@ohana-redis:6379

# Acessos criados na primeira vez (depois pode trocar a senha no painel)
ADMIN_NAME=Leonardo
ADMIN_EMAIL=
ADMIN_PASSWORD=
TEAM_NAME=Equipe
TEAM_EMAIL=
TEAM_PASSWORD=

# Evolution API (WhatsApp dos grupos)
EVOLUTION_URL=https://evolution.rastahale.com.br
EVOLUTION_API_KEY=        # a mesma AUTHENTICATION_API_KEY da Evolution
EVOLUTION_INSTANCE=rastahale
WEBHOOK_SECRET=           # outro texto aleatório

# Shopify (app personalizado com leitura de pedidos, produtos e relatórios)
SHOPIFY_STORE_DOMAIN=rastahale.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Meta Ads (gasto do dia)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# IA (comandos no grupo e dica do relatório)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Transcrição dos áudios (qualquer API compatível com a da OpenAI)
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
